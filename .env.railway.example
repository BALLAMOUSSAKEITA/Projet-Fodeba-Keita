# Variables Railway — service BACKEND (sgep-api)
# DATABASE_URL est injectée automatiquement en liant PostgreSQL

SECRET_KEY=generer-une-cle-secrete-longue-et-aleatoire
ENVIRONMENT=production
CORS_ORIGINS=https://VOTRE-FRONTEND.up.railway.app

# Optionnel — ajouter un plugin Redis Railway
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# --- Variables Railway — service FRONTEND (sgep-web) ---
# API_BACKEND_URL=https://VOTRE-BACKEND.up.railway.app
# (recommandé — proxy runtime, pas de rebuild nécessaire)
# NEXT_PUBLIC_API_URL=  ← laisser vide en production Railway
# PORT est défini automatiquement par Railway
