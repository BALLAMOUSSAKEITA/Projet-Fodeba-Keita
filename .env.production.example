# Copier vers .env.production avant déploiement
# cp .env.production.example .env.production

# URL publique du serveur école (IP Wi-Fi interne)
PUBLIC_URL=http://192.168.1.10
CORS_ORIGINS=http://192.168.1.10
HTTP_PORT=80

# PostgreSQL — CHANGER les mots de passe en production
POSTGRES_USER=sgep
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_FORT
POSTGRES_DB=sgep_db

# MinIO
MINIO_ROOT_USER=sgep_minio
MINIO_ROOT_PASSWORD=CHANGER_MOT_DE_PASSE_FORT
MINIO_BUCKET=sgep-files

# API
SECRET_KEY=GENERER_CLE_SECRETE_LONGUE_ALEATOIRE
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sync cloud (architecture hybride — optionnel)
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_HOST=
CLOUD_SYNC_USER=
CLOUD_SYNC_PATH=/backups/sgep-fodebakeita
